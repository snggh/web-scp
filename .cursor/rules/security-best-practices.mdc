func CreateSecureSFTPConnection(host string, port int, username, password string) (*sftp.Client, error) {
    // Use SSH key authentication when possible
    config := &ssh.ClientConfig{
        User: username,
        Auth: []ssh.AuthMethod{
            ssh.Password(password), // Fallback to password
            // ssh.PublicKeys(key), // Preferred method
        },
        HostKeyCallback: ssh.InsecureIgnoreHostKey(), // In production, use proper host key verification
        Timeout: 30 * time.Second,
    }

    // For production, implement proper host key verification
    hostKeyCallback := func(hostname string, remote net.Addr, key ssh.PublicKey) error {
        // Verify against known hosts
        return nil
    }

    addr := fmt.Sprintf("%s:%d", host, port)
    conn, err := ssh.Dial("tcp", addr, config)
    if err != nil {
        return nil, fmt.Errorf("failed to connect: %w", err)
    }

    client, err := sftp.NewClient(conn)
    if err != nil {
        conn.Close()
        return nil, fmt.Errorf("failed to create SFTP client: %w", err)
    }

    return client, nil
